# Your domain, pointed (A record) at this server. Caddy gets HTTPS for it automatically.
DOMAIN=fin.example.com

# Login. Generate the hash with:
#   docker compose run --rm app python -m finance.security "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Long random string. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Keep true on the server (HTTPS). Set false only for local http testing.
SESSION_HTTPS_ONLY=true

# AI for the chat assistant and screenshot reading — set ONE of the keys.
# Everything else works without it.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Or Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# If both keys are set, OpenAI is used unless LLM_PROVIDER=anthropic.
LLM_PROVIDER=

# Reports use "today" in this time zone.
TIMEZONE=Asia/Tashkent
