# --- Amazon Creators API (замена PA-API 5, закрытого 15 мая 2026) ---
# Associates Central -> Tools -> Creators API -> создать credentials версии 3.x
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# 3.1 = США/Канада/Мексика/Бразилия, 3.2 = Европа/UK/Индия, 3.3 = Япония/Австралия/Сингапур
AMAZON_CREDENTIAL_VERSION=3.1
# Ваш tracking ID из Associates, например mysite-20
AMAZON_PARTNER_TAG=
AMAZON_COUNTRY=US

# --- Отбор товаров ---
MIN_RATING=4.0
MIN_REVIEWS=100
PRODUCTS_PER_SITE=12
# Агент сам подбирает ниши и держит минимум столько сайтов (0 = только ваши ниши)
AUTO_NICHES=3

# --- Тексты (LLM): anthropic | openai ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- PropellerAds (пуш-реклама) ---
# SSP -> Profile -> API token (API доступен после $1000 расхода/депозита)
PROPELLER_API_TOKEN=
# false = тестовый режим: кампании собираются, но не отправляются.
PUSH_LIVE=false
PUSH_COUNTRIES=US
PUSH_BID_CPC=0.03
CAMPAIGN_DAILY_BUDGET=10
# Жёсткий лимит: сумма дневных бюджетов всех активных кампаний
MAX_DAILY_SPEND=30
CAMPAIGNS_PER_SITE=3
# Отключать кампанию после KILL_MIN_SPEND $, если клик на Amazon дороже MAX_COST_PER_AMAZON_CLICK $
KILL_MIN_SPEND=5
MAX_COST_PER_AMAZON_CLICK=0.40
# Площадка с расходом >= ZONE_MIN_SPEND $ и без кликов на Amazon -> чёрный список
ZONE_MIN_SPEND=1

# --- Агент ---
# Каждые N часов: обновить товары (цены не старше 24ч!) -> тексты -> оптимизация -> новые кампании.
# Держите <= 24, иначе цены на сайтах будут скрыты как устаревшие.
AGENT_INTERVAL_HOURS=6

# --- Сайт / деплой ---
DOMAIN=
# Название на главной странице (по умолчанию из домена)
SITE_NAME=
# Email для связи на страницах Contact и Privacy (форма связи работает и без него)
CONTACT_EMAIL=
DATA_DIR=data
ADMIN_USERNAME=admin
# python -m amzagent.security "ваш-пароль"
ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_HTTPS_ONLY=true
