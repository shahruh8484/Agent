# --- Amazon Creators API (замена PA-API 5, закрытого 15 мая 2026) ---
# Associates Central -> Tools -> Creators API -> создать credentials версии 3.x
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# 3.1 = США/Канада/Мексика/Бразилия, 3.2 = Европа/UK/Индия, 3.3 = Япония/Австралия/Сингапур
AMAZON_CREDENTIAL_VERSION=3.1
# Ваш tracking ID из Associates, например mysite-20
AMAZON_PARTNER_TAG=
AMAZON_COUNTRY=US

# --- Отбор товаров ---
MIN_RATING=4.0
MIN_REVIEWS=100
PRODUCTS_PER_SITE=12
# Агент сам подбирает ниши и держит минимум столько сайтов (0 = только ваши ниши)
AUTO_NICHES=3

# --- Тексты (LLM): anthropic | openai ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Картинки для пушей ---
# ai = рисует нейросеть OpenAI (нужен OPENAI_API_KEY, ~$0.05 за картинку),
# simple = текст на градиенте, бесплатно. При ошибке ai агент сам берёт simple.
PUSH_CREATIVES=ai
PUSH_CREATIVE_VARIANTS=2
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# --- PropellerAds (пуш-реклама) ---
# SSP -> Profile -> API token (API доступен после $1000 расхода/депозита)
PROPELLER_API_TOKEN=
# false = тестовый режим: кампании собираются, но не отправляются.
PUSH_LIVE=false
PUSH_COUNTRIES=US
PUSH_BID_CPC=0.03
CAMPAIGN_DAILY_BUDGET=10
# Жёсткий лимит: сумма дневных бюджетов всех активных кампаний
MAX_DAILY_SPEND=30
CAMPAIGNS_PER_SITE=3
# Тест товара: после KILL_MIN_SPEND $ кампанию отключают, если на Amazon перешло
# меньше MIN_AMAZON_RATE % посетителей (0 = правило выключено)
KILL_MIN_SPEND=1
MIN_AMAZON_RATE=1
# И/или если переход на Amazon дороже MAX_COST_PER_AMAZON_CLICK $ (0 = выключено)
MAX_COST_PER_AMAZON_CLICK=0
# У кампаний, прошедших тест: зона без переходов на Amazon отключается, когда набрала
# ZONE_MIN_VISITS визитов или ZONE_MIN_SPEND $ расхода; зоны с переходами остаются
ZONE_MIN_VISITS=15
ZONE_MIN_SPEND=1

# --- Агент ---
# Каждые N часов: обновить товары (цены не старше 24ч!) -> тексты -> оптимизация -> новые кампании.
# Держите <= 24, иначе цены на сайтах будут скрыты как устаревшие.
AGENT_INTERVAL_HOURS=6

# --- Сайт / деплой ---
DOMAIN=
# Название на главной странице (по умолчанию из домена)
SITE_NAME=
# Email для связи на страницах Contact и Privacy (форма связи работает и без него)
CONTACT_EMAIL=
DATA_DIR=data
# Часовой пояс для времени в панели
PANEL_TIMEZONE=Asia/Tashkent
ADMIN_USERNAME=admin
# python -m amzagent.security "ваш-пароль"
ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_HTTPS_ONLY=true

# --- Трейдинг (вкладка «Трейдинг», бот EVEDEX из ../cryptobot) ---
# Бот запускается отдельным контейнером только при COMPOSE_PROFILES=trading.
# COMPOSE_PROFILES=trading
# demo = тестовые USDT; prod = РЕАЛЬНЫЕ деньги и только вместе с TRADER_REAL_MONEY=yes
TRADER_ENV=demo
TRADER_REAL_MONEY=
# Имя инструмента на EVEDEX (на демо BTCUSDT:DEMO)
TRADER_INSTRUMENT=BTCUSDT:DEMO
# Свечи для сигналов: пара и биржа (binance, bybit, okx)
TRADER_SIGNAL_SYMBOL=BTC/USDT
TRADER_SIGNAL_EXCHANGE=binance
# Несколько монет сразу (заменяет две строки выше). Пара для сигналов по умолчанию <монета>/USDT,
# свою можно указать через "=": XRPUSD,LINKUSD,TAOUSD=TAO/USDT
TRADER_INSTRUMENTS=
# Сколько позиций одновременно по всем монетам (баланс у них общий)
TRADER_MAX_POSITIONS=2
# Новостной фильтр (ИИ из LLM_PROVIDER / OPENAI_API_KEY выше): off | shadow | on
# shadow — только записывает, что сделал бы; on — пропускает входы и закрывает позиции на плохих новостях
TRADER_NEWS=shadow
# Оценка новостей от -1 до 1: при <= BLOCK вход пропускается, при <= EXIT позиция закрывается
TRADER_NEWS_BLOCK=-0.3
TRADER_NEWS_EXIT=-0.7
TRADER_TIMEFRAME=1h
TRADER_LEVERAGE=1
# Жёсткий потолок размера позиции, $
TRADER_MAX_USD=100
# Доля баланса, которую теряем при срабатывании стопа (0.01 = 1%)
TRADER_RISK=0.01
# EVEDEX -> профиль -> Settings -> API; и ключ one-click-trading кошелька
EVEDEX_API_KEY=
EVEDEX_OCT_PRIVATE_KEY=
