# Скопируйте этот файл в .env (cp .env.example .env) и поправьте под себя.
# Файл .env в git не попадает — ключи храните только в нём.

# --- Модель для vLLM (этап 0: меняем и сравниваем) ---
# Точные названия проверяет: python stage0/find_models.py
MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
# Сколько токенов контекста держать (промпт + разговор). 8192 хватает для звонка.
MAX_MODEL_LEN=8192
# Какую долю видеопамяти отдать модели.
GPU_MEM=0.90
# Доп. параметры vLLM, если понадобятся (например: --quantization fp8 --tensor-parallel-size 2)
EXTRA_VLLM_ARGS=

# Токен Hugging Face — нужен только для «закрытых» моделей (Gemma, Llama).
# Взять: huggingface.co → Settings → Access Tokens (Read). В чат не присылать!
HF_TOKEN=
# Где хранить скачанные модели (на RunPod /workspace сохраняется при Stop).
HF_HOME=/workspace/hf

# --- Как скрипты обращаются к модели ---
LLM_BASE_URL=http://localhost:8000/v1
# Модель-«клиент» для автопрогона. Пусто = та же модель, что и бот.
SIM_BASE_URL=
SIM_MODEL=

# --- Поведение бота ---
PROMPT_FILE=prompts/system_prompt_uz.md
TEMPERATURE=0.3
MAX_REPLY_TOKENS=400
# Отключать «размышления» модели (1 = да; для звонка нужно 1, иначе медленно).
DISABLE_THINKING=1
# Реплика длиннее стольких слов считается длинной.
MAX_WORDS=25
