    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
