# --- Обязательно для продакшена ---
NODE_ENV=production
DATABASE_URL=postgres://dx:dx@localhost:5432/dasturxon
JWT_SECRET=замените-на-длинную-случайную-строку
PUBLIC_URL=https://api.dasturxon.uz      # базовый адрес для ссылок на загруженные фото
CORS_ORIGIN=https://admin.dasturxon.uz
DEV_OTP=false                            # true — код SMS возвращается в ответе (только для разработки!)

# --- SMS: Eskiz.uz ---
SMS_PROVIDER=mock                        # mock | eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Оплата: Payme Business (Subscribe API) ---
PAYMENT_PROVIDER=mock                    # mock | payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_URL=https://checkout.paycom.uz/api

# --- Доставка: Яндекс Go for Business ---
DELIVERY_PROVIDER=mock                   # mock | yandex
YANDEX_GO_TOKEN=
YANDEX_GO_URL=https://b2b.taxi.yandex.net/b2b/cargo/integration
DELIVERY_MOCK_SPEED=10                   # ускорение симуляции курьера в mock-режиме

# --- Push: Firebase Cloud Messaging ---
FCM_SERVER_KEY=

# --- AI-проверка фото кухни (Claude API). Без ключа — только ручная проверка ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Бизнес-параметры (комиссию и др. владелец также меняет в админке) ---
COMMISSION_PCT=20
CHEF_TAX_PCT=4
DELIVERY_BUFFER_PCT=15
EARLY_WITHDRAW_PCT=1
CHEF_ACCEPT_TIMEOUT_SEC=300
SUPPORT_REFUND_LIMIT=50000
SEED_OWNER_PASSWORD=
