# --- Facebook / Meta Marketing API ---
# Create an app at https://developers.facebook.com, add the "Marketing API" product,
# generate a long-lived access token for a user with admin access on the ad account.
FB_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_AD_ACCOUNT_ID=act_XXXXXXXXXX
FB_PAGE_ID=
FB_API_VERSION=v20.0

# --- Competitor analysis (Meta Ad Library, public + free) ---
# Uses the same FB_ACCESS_TOKEN above (needs the ads_read permission).
AD_LIBRARY_COUNTRIES=US

# --- LLM provider for copy, competitor analysis and landing page content ---
# One of: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Image generation for ad creatives ---
# One of: openai | stub  (stub writes a placeholder file, no network/cost — good for testing)
IMAGE_PROVIDER=stub
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Output ---
OUTPUT_DIR=output
