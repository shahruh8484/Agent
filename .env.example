# --- Facebook / Meta Marketing API ---
# Create an app at https://developers.facebook.com, add the "Marketing API" product,
# generate a long-lived access token for a user with admin access on the ad account.
FB_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_AD_ACCOUNT_ID=act_XXXXXXXXXX
FB_PAGE_ID=
FB_API_VERSION=v20.0
# Ad accounts shown on the dashboard (comma-separated act_... ids).
# Falls back to FB_AD_ACCOUNT_ID above if left empty.
FB_AD_ACCOUNT_IDS=

# --- Competitor analysis (Meta Ad Library, public + free) ---
# Uses the same FB_ACCESS_TOKEN above (needs the ads_read permission).
AD_LIBRARY_COUNTRIES=US

# --- LLM provider for copy, competitor analysis and landing page content ---
# One of: anthropic | openai | gemini
# Gemini has a free tier (https://ai.google.dev/pricing) — good if you want
# $0 text generation instead of pay-as-you-go Anthropic/OpenAI.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Image generation for ad creatives ---
# One of: openai | gemini | stub  (stub writes a placeholder file, no network/cost)
# gemini uses the same GEMINI_API_KEY above and is free-tier eligible.
IMAGE_PROVIDER=stub
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# --- Output ---
OUTPUT_DIR=output

# Where the dashboard stores accounts/token added via the FB Accounts page
# (mounted as a Docker volume in docker-compose.yml so it survives rebuilds).
DATA_DIR=data

# --- Dashboard login ---
ADMIN_USERNAME=admin
# Generate with: python -m fbadsagent.web.security "your-password-here"
ADMIN_PASSWORD_HASH=
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set to false only for local http testing. Keep true in production (HTTPS via Caddy).
SESSION_HTTPS_ONLY=true

# How often (hours) the Chat page's background loop posts a proactive idea
# on its own, using ANTHROPIC_API_KEY/OPENAI_API_KEY above. 0 disables it.
CHAT_IDEA_INTERVAL_HOURS=6

# --- Deployment (docker-compose + Caddy) ---
# Your domain, pointed (A record) at the server. Caddy issues an HTTPS cert
# for it automatically. Leave empty until you have a domain to point here.
DOMAIN=
