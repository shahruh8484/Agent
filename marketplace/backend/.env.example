SERVIO_APP_NAME=Servio
SERVIO_DATABASE_PATH=data/servio.db
SERVIO_CURRENCY=RUB

# dev = code is returned in the API response; smsru = real SMS via sms.ru
SERVIO_SMS_PROVIDER=dev
SERVIO_SMSRU_API_ID=

# Free days for a new specialist before the subscription is required
SERVIO_TRIAL_DAYS=7
# dev = subscription activates instantly; yookassa = real payment
SERVIO_PAYMENT_PROVIDER=dev
SERVIO_YOOKASSA_SHOP_ID=
SERVIO_YOOKASSA_SECRET_KEY=
SERVIO_PAYMENT_RETURN_URL=servio://subscription

SERVIO_PUSH_ENABLED=false
