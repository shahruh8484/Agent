SERVIO_APP_NAME=Servio
SERVIO_DATABASE_PATH=data/servio.db
SERVIO_CURRENCY=UZS

# dev = code is returned in the API response; eskiz = real SMS via notify.eskiz.uz
SERVIO_SMS_PROVIDER=dev
SERVIO_ESKIZ_EMAIL=
SERVIO_ESKIZ_PASSWORD=
SERVIO_ESKIZ_FROM=4546
# Must match a template approved in the Eskiz cabinet exactly
SERVIO_SMS_TEMPLATE=Servio: tasdiqlash kodi {code}

# Free days for a new specialist before the subscription is required
SERVIO_TRIAL_DAYS=7
# dev = subscription activates instantly; live = real payments via Payme / Click
SERVIO_PAYMENT_MODE=dev
SERVIO_PAYMENT_RETURN_URL=servio://subscription
SERVIO_PAYME_MERCHANT_ID=
SERVIO_PAYME_KEY=
SERVIO_PAYME_TEST=true
SERVIO_CLICK_SERVICE_ID=
SERVIO_CLICK_MERCHANT_ID=
SERVIO_CLICK_SECRET_KEY=

SERVIO_PUSH_ENABLED=false
